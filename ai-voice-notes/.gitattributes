# Auto detect text files and perform LF normalization
* text=auto

# Force LF for these file types
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   binary
*.mp3   binary
*.mp4   binary
*.wav   binary
*.db    binary
*.sqlite binary
*.safetensors binary
*.bin   binary
*.pt    binary
*.pth   binary
