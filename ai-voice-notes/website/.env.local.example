# Copy this file to .env.local and fill in your values

# For LOCAL NETWORK (same WiFi) - replace with your PC's IP
VITE_API_URL=http://192.168.1.100:8000/api
VITE_WS_URL=ws://192.168.1.100:8000/api

# For NGROK (public internet access)
# VITE_API_URL=https://your-ngrok-url.ngrok.io/api
# VITE_WS_URL=wss://your-ngrok-url.ngrok.io/api

# For LOCAL development only
# VITE_API_URL=http://localhost:8000/api
# VITE_WS_URL=ws://localhost:8000/api
